+def _scanner_declared_rule_ids(request, document_results):
+    """Canonical metadata for already detected declarations; never merger input."""
+    candidates = []
+    registry = getattr(analyzer, "registry", None)
+    for recognizer in getattr(registry, "recognizers", ()):
+        if isinstance(recognizer, Base64DataRecognizer) and recognizer.supported_language == request.language:
+            candidates.extend(recognizer.analyze_declared(request.text, recognizer.supported_entities))
+    # The document pass owns decoded JSON declaration coordinates and precedence.
+    candidates.extend(document_results)
+    rules = {}
+    for result in candidates:
+        metadata = result.recognition_metadata or {}
+        rule = metadata.get("deterministic_rule_id")
+        if metadata.get("encoded_container") is True and rule:
+            rules[(result.entity_type, result.start, result.end)] = rule
+    return rules
+
+
+def _scanner_rule_id(result, declarations):
+    original = (result.recognition_metadata or {}).get("deterministic_rule_id")
+    if detection_source(result) != SOURCE_STRUCTURAL:
+        return original
+    return declarations.get((result.entity_type, result.start, result.end), original)
+
