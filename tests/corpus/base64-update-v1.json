{
  "corpus_version": "base64-update-v1",
  "annotation_scope": "explicit Base64/native filters; not an all-category NER benchmark",
  "cases": [
    {
      "id": "short-declared",
      "path": "base64/short-declared.txt",
      "text": "Base64: YQ==",
      "entities": [
        "BASE64_DATA",
        "PASSWORD",
        "SECRET_KEY",
        "JWT",
        "PRIVATE_KEY"
      ],
      "expected": [
        [
          "BASE64_DATA",
          8,
          12
        ]
      ],
      "reason": "encoded payload; logistic detects the container regardless of decoded sensitivity"
    },
    {
      "id": "unpadded-declared",
      "path": "base64/unpadded-declared.txt",
      "text": "{\"document_base64\":\"aGVsbG8\"}",
      "entities": [
        "BASE64_DATA",
        "PASSWORD",
        "SECRET_KEY",
        "JWT",
        "PRIVATE_KEY"
      ],
      "expected": [
        [
          "BASE64_DATA",
          20,
          27
        ]
      ],
      "reason": "encoded payload; logistic detects the container regardless of decoded sensitivity"
    },
    {
